{
	"name": "pluralbuddy",
	"devDependencies": {
		"@biomejs/biome": "2.0.6",
		"@trivago/prettier-plugin-sort-imports": "^6.0.2"
	},
	"private": true,
	"scripts": {
		"bot": "cd packages/bot && bun run bot",
		"bot:watch": "cd packages/bot && bun run bot:watch",
		"support:bot": "cd packages/support-bot-module && bun run bot",
		"docs:dev": "cd apps/docs && bun run dev",
		"docs:openapi": "cd packages/plurography && bun run src/openapi && cd ../../apps/docs && rm -rf content/docs/pluralbuddy/api && bun run scripts/generate-docs.ts",
		"test": "cd packages/tests && bun test"
	},
	"workspaces": ["packages/*", "apps/*"],
	"dependencies": {
		"seyfert": "4.3.1-dev-25327763678.0"
	}
}